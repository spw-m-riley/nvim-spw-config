#!/bin/sh
case "$*" in
  *fixture-delay*)
    sleep 0.25
    ;;
esac
case "$*" in
  *fixture-null*)
    printf '%s\n' 'null'
    ;;
  *fixture-boolean*)
    printf '%s\n' 'true'
    ;;
  *fixture-number*)
    printf '%s\n' '42'
    ;;
  *--output\ json*|*--output=json*|*-o\ json*|*-o=json*)
    printf '%s\n' '{"status":"STARTED"}'
    ;;
  *)
    printf '%s\n' 'application started'
    ;;
esac
